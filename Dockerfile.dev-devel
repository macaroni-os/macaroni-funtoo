FROM alpine
RUN mkdir /eagle-minimal/etc/ /eagle-minimal/etc/anise -p
ADD conf/anise.yaml.docker.devel /eagle-minimal/etc/anise/anise.yaml
FROM macaronios/anise:latest-amd64

COPY --from=0 /eagle-minimal/ /
ENV USER=root

RUN [ \
  "/usr/bin/anise", "install", "-y", "--force", "--sync-repos", \
  "--cleanup", "--purge-repos", "--config", "/etc/anise/anise.yaml", \
  "repository/mark-dev", \
  "repository/macaroni-commons-dev", \
  "repository/macaroni-eagle-dev"]

RUN [ \
  "/usr/bin/anise", "install", "-y", "--force", "--sync-repos", \
  "--cleanup", "--purge-repos", "--config", "/etc/anise/anise.yaml", \
  "app-admin/entities", \
  "app-admin/anise", \
  "sys-apps/shadow", \
  "sys-apps/sed", \
  "app-shells/bash", \
  "glibc", \
  "gcc", \
  "sys-libs/ncurses", \
  "sys-apps/systemd", \
  "sys-apps/coreutils", \
  "sys-apps/iproute2", \
  "virtual/base", \
  "virtual-entities/base", \
  "app-admin/macaronictl" ]

SHELL ["/bin/bash", "-c"]

RUN macaronictl env-update && \
  anise rm -y --nodeps virtual-entities/base && \
  anise cleanup --purge-repos

ENV TMPDIR=/tmp
ENTRYPOINT ["/bin/bash"]
