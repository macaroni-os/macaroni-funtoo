FROM alpine
RUN mkdir /funtoo-minimal/etc/ /funtoo-minimal/etc/anise -p && \
  cd /funtoo-minimal/etc/ && ln -s anise luet
ADD conf/luet.yaml.docker.devel /funtoo-minimal/etc/anise/anise.yaml
RUN ls -l /funtoo-minimal/etc/
FROM macaronios/luet:latest-amd64

COPY --from=0 /funtoo-minimal/ /
ENV USER=root

RUN [ \
  "/usr/bin/luet", "install", "-y", "--force", "--sync-repos", \
  "--purge-repos", "--config", "/etc/anise/anise.yaml", \
  "repository/mark-dev", \
  "repository/macaroni-commons-dev", \
  "repository/macaroni-phoenix-dev"]

RUN [ \
  "/usr/bin/luet", "install", "-y", "--force", "--sync-repos", \
  "--purge-repos", "--config", "/etc/anise/anise.yaml", \
  "--skip-config-protect", \
  "app-admin/entities", \
  "app-admin/anise", \
  "sys-apps/shadow", \
  "sys-apps/sed", \
  "app-shells/bash", \
  "glibc", \
  "gcc", \
  "sys-apps/iproute2", \
  "sysvinit", \
  "sys-apps/coreutils", \
  "sys-apps/openrc", \
  "virtual/base", \
  "virtual-entities/base", \
  "app-admin/macaronictl-thin" ]

SHELL ["/bin/bash", "-c"]

RUN macaronictl env-update && \
  anise rm -y --nodeps virtual-entities/base && \
  anise cleanup --purge-repos

ENV TMPDIR=/tmp
ENTRYPOINT ["/bin/bash"]
