general:
  debug: false
  client_timeout: 0

  # spinner every 30m
  spinner_ms: 1800000

  show_build_output: true

system:
  tmpdir_base: "/anisemp"

subsets:
  enabled:
    - portage
    - devel

repos_confdir:
  - /etc/anise/repos.conf.d
subsets_defdir:
  - /etc/anise/subsets.def.d

tar_flows:
  max_openfiles: 300
  copy_buffer_size: 128

repositories:
