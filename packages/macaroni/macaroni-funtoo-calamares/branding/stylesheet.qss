/* background color of the side panel */
#sidebarApp {
    background-color: #2A2C31;
}

/* color of the text for the menu elements */
SidebarView {
    background-color: #2A2C31;
    color: #FFFFFF;
}

/* State selected/active */
SidebarView::item:selected {
    background-color: #292F34;
    color: #FFFFFF;
}
